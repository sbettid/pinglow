{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "security:openssf-scorecard",
    ":disableDependencyDashboard"
  ],
  "labels": [
    "dependencies"
  ],
  "reviewers": [
    "sbettid"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo"
      ],
      "rangeStrategy": "bump"
    },
    {
      "matchPackagePrefixes": [
        "kube",
        "k8s",
        "kopium",
        "envtest",
        "schemars"
      ],
      "groupName": "kubernetes crates",
      "matchManagers": [
        "cargo"
      ]
    }
  ]
}