#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  echo "Usage: $0 build <controller|runner|agent|all> | run <controller|runner|agent> [args...] | kind <user-email>"
}

component_package() {
  case "$1" in
    controller) echo pinglow ;;
    runner) echo pinglow-runner ;;
    agent) echo pinglow-agent ;;
    *) return 1 ;;
  esac
}

command="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command" in
  build)
    component="${1:-}"
    if [[ "$component" == "all" ]]; then
      exec cargo build --workspace
    fi
    package="$(component_package "$component")" || {
      usage >&2
      exit 2
    }
    exec cargo build -p "$package"
    ;;
  run)
    component="${1:-}"
    if [[ $# -gt 0 ]]; then
      shift
    fi
    package="$(component_package "$component")" || {
      usage >&2
      exit 2
    }
    if [[ "$component" == "agent" ]]; then
      exec cargo run -p "$package" -- "$@"
    fi
    exec cargo run -p "$package" -- "$@"
    ;;
  kind)
    exec "$ROOT_DIR/dev/kind-controller.sh" "$@"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
